# Copy to .env and fill in. Never commit .env.

# Google OAuth client (Gmail API, read-only access).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Slack app credentials for the "Connect Slack" button.
# Without them you can paste a Slack user token (xoxp-...) on the settings page instead.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional server settings.
# PORT=3157
# HOST=127.0.0.1
# BASE_URL=http://localhost:3157
# POLL_INTERVAL_SECONDS=60
# DATA_DIR=./data

# Optional HTTPS (Slack's OAuth redirect URL must be https).
# TLS_CERT_FILE=./localhost.pem
# TLS_KEY_FILE=./localhost-key.pem

# Optional: 32 random bytes as base64 for encrypting stored credentials.
# If unset, a key is generated at data/secret.key.
# LISTRELAY_SECRET_KEY=

# Required if HOST is not a loopback address: password for the settings page.
# APP_PASSWORD=
